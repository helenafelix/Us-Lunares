<h1>Lista de Horários</h1>

<a href="/horarios/novo">Novo Horário</a>

<table border="1">
    <thead>
        <tr>
            <th>ID</th>
            <th>Horário</th>
            <th>Disciplina</th>
            <th>Sala/Laboratório</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        {{#each horarios}}
        <tr>
            <td>{{this.id_horario}}</td>
            <td>{{this.horarios}}</td>
            <td>{{this.disciplinas}}</td>
            <td>{{this.sala_lab}}</td>
            <td>
                <a href="/horarios/editar/{{this.id_horario}}">Editar</a>
                |
                <a href="/horarios/deletar/{{this.id_horario}}" onclick="return confirm('Tem certeza?')">Deletar</a>
            </td>
        </tr>
        {{else}}
        <tr>
            <td colspan="5">Nenhum horário cadastrado.</td>
        </tr>
        {{/each}}
    </tbody>
</table>