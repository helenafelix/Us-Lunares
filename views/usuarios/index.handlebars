<h1>Lista de Usuários</h1>

<a href="/usuarios/novo">Novo Usuário</a>

<table border="1">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Email</th>
            <th>Matrícula</th> 
            <th>Perfil</th> 
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        {{#each usuarios}}
        <tr>
            <td>{{this.id}}</td>
            <td>{{this.nome}}</td>
            <td>{{this.email}}</td>
            <td>{{this.matricula}}</td> 
            <td>{{this.perfil}}</td> 
            <td>
                <a href="/usuarios/editar/{{this.id}}">Editar</a>
                |
                <a href="/usuarios/deletar/{{this.id}}" onclick="return confirm('Tem certeza?')">Deletar</a>
            </td>
        </tr>
        {{else}}
        <tr>
            <td colspan="6">Nenhum usuário cadastrado.</td> 
        </tr>
        {{/each}}
    </tbody>
</table>